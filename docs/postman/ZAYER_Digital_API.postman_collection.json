        { "name": "Replay identical quote payment [200]", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{quotePaymentKey}}" }], "body": { "mode": "raw", "raw": "{\"amount\":1,\"note\":\"Fictional Postman local payment test\"}" }, "url": "{{baseUrl}}/quotes/{{adminApprovedQuoteId}}/payments" }},
        { "name": "Reject changed request under same payment key [409]", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{quotePaymentKey}}" }], "body": { "mode": "raw", "raw": "{\"amount\":2,\"note\":\"Changed request must conflict\"}" }, "url": "{{baseUrl}}/quotes/{{adminApprovedQuoteId}}/payments" }},
        { "name": "Reject payment without idempotency key [400]", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"amount\":1}" }, "url": "{{baseUrl}}/quotes/{{adminApprovedQuoteId}}/payments" }},
        { "name": "Reject payment exceeding quote balance [409]", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "over-balance-{{testRunId}}" }], "body": { "mode": "raw", "raw": "{\"amount\":100000,\"note\":\"Expected to exceed remaining balance\"}" }, "url": "{{baseUrl}}/quotes/{{adminApprovedQuoteId}}/payments" }},
        { "name": "List retainer collections [200]", "request": { "method": "GET", "url": "{{baseUrl}}/retainer-collections?limit=20" }},
        { "name": "Filter upcoming installments [200]", "request": { "method": "GET", "url": "{{baseUrl}}/retainer-collections?state=upcoming" }},
        { "name": "Record isolated retainer payment [200]", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{retainerPaymentKey}}" }], "body": { "mode": "raw", "raw": "{\"amount\":1,\"note\":\"Fictional Postman local installment test\"}" }, "url": "{{baseUrl}}/retainer-collections/{{demoCollectionId}}/payments" }}
      ]
    },
    {
      "name": "User and agent administration",
      "item": [
        { "name": "List users [200]", "request": { "method": "GET", "url": "{{baseUrl}}/users?limit=20" }},
        { "name": "Read seeded user [200]", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{demoUserId}}" }},
        { "name": "Update seeded user display name [200]", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Demo Standard User\"}" }, "url": "{{baseUrl}}/users/{{demoUserId}}" }},
        { "name": "Create demo agent [201]", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Postman Demo Agent\",\"email\":\"agent.{{testRunId}}@example.test\",\"password\":\"{{testUserPassword}}\"}" }, "url": "{{baseUrl}}/users/agents" }},
        { "name": "Deactivate isolated demo agent [200]", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"isActive\":false}" }, "url": "{{baseUrl}}/users/agents/{{createdAgentId}}" }},
        { "name": "Delete isolated demo agent [200]", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{createdAgentId}}" }},
        { "name": "Delete registered test user [200]", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{registeredUserId}}" }},
        { "name": "Reject standard-user admin endpoint [403]", "request": { "method": "GET", "url": "{{baseUrl}}/users", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] } }},
        { "name": "Revoke standard-user token [200]", "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] } } }
