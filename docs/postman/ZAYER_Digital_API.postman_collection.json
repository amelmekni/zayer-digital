{
  "info": {
    "_postman_id": "0f5a73c7-3582-47eb-a3c5-2a2d7d8f2026",
    "name": "ZAYER Digital API — Local QA",
    "description": "Local-only API smoke and workflow suite. It refuses non-loopback base URLs. Start the API only with the dedicated local zayer_digital_test database; some successful create workflows persist records because the API has no delete endpoint for quotes, applications, contacts, or public requests. See docs/postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl');",
          "if (!base) throw new Error('Set baseUrl to your local API ending in /api.');",
          "const parsed = new URL(base);",
          "if (!['localhost', '127.0.0.1', '[::1]', '::1'].includes(parsed.hostname.toLowerCase()) || parsed.pathname.replace(/\\/$/, '') !== '/api') {",
          "  throw new Error('Safety stop: this collection may only call a loopback API URL ending in /api.');",
          "}",
          "if (pm.request.name.startsWith('Register isolated test user')) {",
          "  const run = `postman-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;",
          "  pm.environment.set('testRunId', run);",
          "  pm.environment.set('testUserEmail', `${run}@example.test`);",
          "  pm.environment.set('quotePaymentKey', `quote-${run}-payment`);",
          "  pm.environment.set('retainerPaymentKey', `retainer-${run}-payment`);",
          "}",
          "if (!pm.environment.get('testRunId')) pm.environment.set('testRunId', `postman-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`);",
          "const run = pm.environment.get('testRunId');",
          "if (!pm.environment.get('testUserEmail')) pm.environment.set('testUserEmail', `${run}@example.test`);",
          "if (!pm.environment.get('quotePaymentKey')) pm.environment.set('quotePaymentKey', `quote-${run}-payment`);",
          "if (!pm.environment.get('retainerPaymentKey')) pm.environment.set('retainerPaymentKey', `retainer-${run}-payment`);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedMatch = pm.request.name.match(/\\[(\\d{3})(?:\\s+PDF)?\\]$/);",
          "pm.test('Request documents its expected HTTP status', () => pm.expect(expectedMatch, pm.request.name).to.not.equal(null));",
          "if (expectedMatch) pm.test(`HTTP ${expectedMatch[1]}`, () => pm.response.to.have.status(Number(expectedMatch[1])));",
          "const expectsPdf = /\\[\\d{3}\\s+PDF\\]$/.test(pm.request.name);",
          "if (expectsPdf && pm.response.code < 400) pm.test('PDF response has the expected content type and download header', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment'); });",
          "if (!expectsPdf) {",
          "  let body;",
          "  try { body = pm.response.json(); } catch { body = null; }",
          "  pm.test('JSON response uses the API envelope', () => { pm.expect(body, 'response JSON').to.be.an('object'); pm.expect(body.success).to.be.a('boolean'); });",
          "  if (body && body.success === true && body.data && typeof body.data === 'object') {",
          "    if (pm.request.name.startsWith('Create test application')) pm.test('Public application response omits CV content', () => pm.expect(body.data).to.not.have.property('cv'));",
          "    if (pm.request.name.startsWith('Create isolated test quote')) pm.test('Quote totals are calculated by the API from the demo catalog', () => { pm.expect(body.data.status).to.equal('draft'); pm.expect(body.data.total).to.equal(450); pm.expect(body.data.depositAmount).to.equal(90); pm.expect(body.data.currency).to.equal('TND'); });",
          "    if (pm.request.name.startsWith('Send created quote')) pm.test('Quote status changed to sent', () => pm.expect(body.data.status).to.equal('sent'));",
          "    if (pm.request.name.startsWith('Approve created quote')) pm.test('Approved quote status is returned', () => pm.expect(body.data.status).to.equal('approved'));",
          "    if (pm.request.name.startsWith('Record isolated quote payment')) pm.environment.set('quotePaymentSnapshot', JSON.stringify(body.data));",
          "    if (pm.request.name.startsWith('Replay identical quote payment')) pm.test('Exact replay does not apply a second payment', () => pm.expect(JSON.stringify(body.data)).to.equal(pm.environment.get('quotePaymentSnapshot')));",
          "    if (pm.request.name.startsWith('Submit public quote request')) pm.test('Public quote request is not an official quote', () => { pm.expect(body.data.officialQuoteCreated).to.equal(false); pm.expect(body.data.total).to.equal(450); pm.expect(body.data.currency).to.equal('TND'); });",
          "    if (pm.request.name.startsWith('Login as admin')) pm.environment.set('adminToken', body.data.token);",
          "    if (pm.request.name.startsWith('Login as sales agent')) pm.environment.set('salesToken', body.data.token);",
          "    if (pm.request.name.startsWith('Login as standard user')) pm.environment.set('userToken', body.data.token);",
          "    if (pm.request.name.startsWith('Register isolated test user')) pm.environment.set('registeredUserId', body.data.user.id);",
          "    if (pm.request.name.startsWith('Create demo service')) pm.environment.set('createdServiceId', body.data._id);",
          "    if (pm.request.name.startsWith('Create demo project')) pm.environment.set('createdProjectId', body.data._id);",
          "    if (pm.request.name.startsWith('Create demo job')) pm.environment.set('createdJobId', body.data._id);",
          "    if (pm.request.name.startsWith('Create demo agent')) pm.environment.set('createdAgentId', body.data.id);",
          "    if (pm.request.name.startsWith('Create isolated test quote')) pm.environment.set('createdQuoteId', body.data._id);",
          "    if (pm.request.name.startsWith('Create test contact')) pm.environment.set('createdContactId', body.data._id);",
          "    if (pm.request.name.startsWith('Create test application')) pm.environment.set('createdApplicationId', body.data._id);",
          "  }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000/api" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
